{
  "name": "rust-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Unified Rust map, monument and PC skin studio (Tauri + React + Three.js + Rust/Python engine).",
  "workspaces": [
    "apps/desktop/ui",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rust-studio/ui",
    "build": "npm run build --workspace @rust-studio/ui",
    "typecheck": "npm run typecheck --workspace @rust-studio/ui",
    "tauri": "npm --prefix apps/desktop run tauri",
    "tauri:dev": "npm --prefix apps/desktop run tauri -- dev",
    "tauri:build": "npm --prefix apps/desktop run tauri -- build",
    "check:assets": "node scripts/check-asset-names.mjs",
    "ios:tablet": "node scripts/ios-tablet-only.mjs",
    "index:assets": "bash scripts/index-kobaedit-assets.sh",
    "index:local": "python3 engine/scripts/index_local_assets.py --db data/rust-studio.db"
  }
}
