{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KOBA Studios",
  "version": "1.6.0",
  "identifier": "net.ruststudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../studio-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "title": "KOBA Studios",
        "width": 720,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "skipTaskbar": true,
        "theme": "Dark",
        "backgroundColor": "#0b0d10"
      },
      {
        "label": "main",
        "title": "KOBA Studios",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "theme": "Light",
        "backgroundColor": "#f8fafc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' asset: http://asset.localhost ipc: http://ipc.localhost; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Desktop/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kobastudios"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "msi",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Rust map, monument, skin and CUI studio",
    "longDescription": "Offline-first Rust map, monument, skin and CUI plugin studio with a guided wizard and full studio mode, built on Tauri, Three.js and WebGL2.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
